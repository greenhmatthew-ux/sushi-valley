; Engine configuration file.
; Sushi Valley — Godot 4.7 port.

config_version=5

[application]

config/name="Sushi Valley"
config/description="A single-player Japanese-learning RPG. Gather, craft, fight, and recall."
config/version="0.1.0"
run/main_scene="res://src/scenes/world.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Bus="*res://src/autoload/bus.gd"
DB="*res://src/autoload/db.gd"

[display]

; 16px tiles at zoom 2 = a 640x360 design resolution (matches the old GameConfig ZOOM=2).
; canvas_items + integer scaling keeps pixel art crisp at any window size.
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[file_customization]

folder_colors={
"res://assets/": "green",
"res://data/": "yellow",
"res://docs/": "gray",
"res://src/": "blue",
"res://tests/": "purple"
}

