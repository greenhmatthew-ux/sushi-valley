    { "id": "travel-dining-english-menu", "sourceNoteId": "1738219456110", "lessonId": "travel-dining", "type": "phrase", "prompt": "英語のメニューがありますか。", "answer": "Do you have an English menu?", "choices": ["Do you have an English menu?", "Do you have Wi-Fi?", "What is the password?", "Can I use a credit card?"], "reading": "Eigo no menyuu ga arimasu ka.", "meaning": "Do you have an English menu?", "tags": ["travel", "dining", "communication"] },
    { "id": "travel-dining-recommendation", "sourceNoteId": "1738219456111", "lessonId": "travel-dining", "type": "phrase", "prompt": "おすすめは何ですか。", "answer": "What do you recommend?", "choices": ["What do you recommend?", "How much is it?", "Is this meat?", "Please say it again?"], "reading": "Osusume wa nan desu ka.", "meaning": "What do you recommend?", "tags": ["travel", "dining", "ordering"] },
