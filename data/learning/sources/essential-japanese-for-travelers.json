    { "id": "travel-arrival-thank-you", "sourceNoteId": "1738219456103", "lessonId": "travel-arrival", "type": "phrase", "prompt": "ありがとうございます。", "answer": "Thank you.", "choices": ["Thank you.", "Excuse me.", "How much is it?", "What is the password?"], "reading": "Arigatoogozaimasu.", "meaning": "Thank you.", "tags": ["travel", "arrival", "politeness"] },
    { "id": "travel-arrival-repeat", "sourceNoteId": "1738219456106", "lessonId": "travel-arrival", "type": "phrase", "prompt": "もう一度おねがいします。", "answer": "Please say it again?", "choices": ["Please say it again?", "What do you recommend?", "Where is the bathroom?", "Do you have Wi-Fi?"], "reading": "Mooichido onegaishimasu.", "meaning": "Please say it again?", "tags": ["travel", "arrival", "communication"] },
    { "id": "travel-arrival-bathroom", "sourceNoteId": "1738219456107", "lessonId": "travel-arrival", "type": "phrase", "prompt": "お手洗いはどこですか。", "answer": "Where is the bathroom?", "choices": ["Where is the bathroom?", "Where should I get off?", "How long does it take to the hotel?", "Which bus goes to Haneda Airport?"], "reading": "Otearai wa doko desu ka.", "meaning": "Where is the bathroom?", "tags": ["travel", "arrival", "facilities"] },
